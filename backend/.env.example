# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the model
GROQ_MODEL=llama-3.3-70b-versatile

# When the server's free Groq key gets rate-limited (or a query is too large
# for it), requests are retried once on Claude Haiku 4.5 via AWS Bedrock.
# Requires AWS credentials to be resolvable via boto3's normal chain — e.g. an
# EC2 instance role (nothing to set below), or:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional overrides:
# BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_MODEL_LABEL=Claude Haiku 4.5
